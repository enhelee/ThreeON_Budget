# ThreeON 예산 — 환경변수 예시
#
# ⚠ .env 는 «두 자리» 중 하나에 둔다. 실행 방식이 결정한다.
#   로컬 개발(py -m uvicorn):  app/.env        ← server.py 가 자기 폴더의 .env 를 읽는다(app/src/budget/auth.py)
#   Docker(compose / 사내 서버): 이 파일과 같은 자리의 .env  ← deploy/docker-compose.yml 이 ../.env 로 읽는다
#   Render:                    쓰지 않는다 — 대시보드 환경변수에 같은 키를 입력한다(render.yaml)
# 실제 값이 담긴 .env 는 절대 커밋하지 않는다(.gitignore).
# 사내 서버 절차: docs/사내이관_가이드.md

# ── 인증 ─────────────────────────────────────────────────────
# 팀 공용 비밀번호. 12자 이상 권장. 작업자 이름과 함께 입력해 로그인한다. 비우면 로그인 없이 열린다(개발용).
APP_PASSWORD=change-me-12자이상

# 세션 쿠키 서명 키. 바뀌면 모든 로그인이 풀린다. 비우면 임시 키 → 재시작마다 로그인이 풀린다.
#   생성:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Render 는 generateValue 로 자동 생성하므로 입력하지 않는다.
SECRET_KEY=

# 로그인 유효시간(시간)
SESSION_HOURS=12

# HTTPS 전용 쿠키. http(로컬·사내 프록시 없음)는 0, https(Render·사내 HTTPS 프록시 뒤)는 1.
# 틀리면 로그인이 안 된다 — http 인데 1 이면 쿠키가 아예 붙지 않는다.
COOKIE_SECURE=0

# 메인 화면 헤더에 표시할 리비전 문자열(사람이 읽는 값). 커밋 해시는 /healthz 가 따로 찍는다.
APP_REV=dev

# ── 데이터 ───────────────────────────────────────────────────
# 비우면 SQLite(로컬 app/data/budget.db · Docker 는 볼륨 budget_data). PostgreSQL 사용 시 연결 문자열.
#   Supabase: Connect → Session pooler(5432), 끝에 ?sslmode=require
#   사내 compose --profile pg: postgresql://budget:<PG_PASSWORD>@postgres:5432/budget
#   주의 1) 자리표시자 대괄호 [ ] 를 지울 것
#   주의 2) 비밀번호의 특수문자는 퍼센트 인코딩할 것 (@ → %40 등)
#   주의 3) 테스트용 PG_TEST_URL 에 이 값을 넣지 말 것 — 테스트가 표를 TRUNCATE 한다
DATABASE_URL=

# 앱 상태 폴더(로컬 전용). 비우면 app/ 기준 상대경로(data/ · output/).
# 컨테이너에서는 Dockerfile 이 /data/budget 으로 정하므로 여기 값은 무시된다.
DATA_DIR=
OUT_DIR=

# ── Docker / 사내 서버 (deploy/docker-compose.yml 만 읽는다) ─────
# 서버에서 열 포트. 팀원은 http://<서버IP>:<HOST_PORT>/ 로 접속.
HOST_PORT=8080

# --profile pg 로 PostgreSQL 컨테이너를 같이 띄울 때만. 비우면 SQLite 모드.
PG_DB=budget
PG_USER=budget
PG_PASSWORD=
