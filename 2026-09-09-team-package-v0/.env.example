# ThreeON 예산 — 환경변수 예시
#
# 사용법:  이 파일을 app/.env 로 복사한 뒤 값을 채운다.
#            cp .env.example app/.env
#          (server.py 가 자기 폴더의 .env 를 읽는다 — app/src/budget/auth.py)
#
# Render·사내 서버에서는 이 파일을 쓰지 않고, 플랫폼의 환경변수 화면에 같은 키를 직접 입력한다.
# 실제 값이 담긴 .env 는 절대 커밋하지 않는다(.gitignore).

# ── 인증 ─────────────────────────────────────────────────────
# 팀 공용 비밀번호. 12자 이상 권장. 작업자 이름과 함께 입력해 로그인한다.
APP_PASSWORD=change-me-12자이상

# 세션 쿠키 서명 키. 바뀌면 모든 로그인이 풀린다.
#   생성:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Render 는 generateValue 로 자동 생성하므로 입력하지 않는다.
SECRET_KEY=

# 로그인 유효시간(시간)
SESSION_HOURS=12

# HTTPS 전용 쿠키. 로컬(http)은 0, 배포(https)는 1.
COOKIE_SECURE=0

# ── 실행 환경 ────────────────────────────────────────────────
# local | render | onprem — 기본값 분기에 쓴다.
APP_ENV=local

# 메인 화면 헤더에 표시할 리비전 문자열.
APP_REV=rev15

# ── 데이터 ───────────────────────────────────────────────────
# 비우면 SQLite(app/data/budget.db). PostgreSQL 사용 시 연결 문자열.
#   Supabase: Connect → Direct/Connection string → Session pooler(5432), 끝에 ?sslmode=require
#   주의 1) 자리표시자 대괄호 [ ] 를 지울 것
#   주의 2) 비밀번호의 특수문자는 퍼센트 인코딩할 것 (@ → %40 등)
#   주의 3) 테스트용 PG_TEST_URL 에 이 값을 넣지 말 것 — 테스트가 표를 TRUNCATE 한다
DATABASE_URL=

# 앱 상태 폴더. 비우면 app/ 기준 상대경로(data/ · config/ · output/).
# 컨테이너에서는 entrypoint.sh 가 /data/budget 으로 덮어쓴다.
DATA_DIR=
CONFIG_DIR=
OUT_DIR=

# ── 중장기 전망 (Phase 4~5 한시) ──────────────────────────────
# 메인 앱 5번 탭이 iframe 으로 띄우는 주소.
# Phase 6 에서 전망 기능을 흡수하면 이 변수는 삭제된다.
FORECAST_URL=/forecast

# /forecast 기본인증 사용자명 (Phase 4 에서 forward_auth 로 대체 예정)
BASIC_USER=team
