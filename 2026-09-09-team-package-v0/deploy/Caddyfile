# 한 주소로 통합 — 경로별 라우팅. HTTPS는 Render/사내 프록시가 종단(auto_https off).
{
	admin off
	auto_https off
}

:{$PORT}

encode gzip
header {
	X-Content-Type-Options nosniff
	X-Frame-Options SAMEORIGIN
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

# ── 소개·문서 사이트 (docs/index.html) ──
handle /site {
	redir /site/ permanent
}
handle_path /site/* {
	root * /srv/site
	file_server
}

# ── budget_app (FastAPI). SPA는 /app/, API는 절대경로 /api/* ──
handle /app {
	redir /app/ permanent
}
handle_path /app/* {
	reverse_proxy 127.0.0.1:8010
}
# ⚠ Vite 빌드 SPA 는 자산을 절대경로 /assets/... 로 부른다(base:"/").
#   이 블록이 없으면 아래 "그 외 = 소개 사이트" 로 떨어져 CSS·JS 가 404 가 되고,
#   HTML 만 뜬 빈 화면이 된다. 파일명에 해시가 붙으므로 캐시는 길게 잡아도 안전하다.
handle /assets/* {
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy 127.0.0.1:8010
}

handle /api/* {
	reverse_proxy 127.0.0.1:8010
}
handle /healthz {
	reverse_proxy 127.0.0.1:8010
}

# ── forecast_app (Streamlit, baseUrlPath=forecast). 앱 세션을 엣지에서 확인 ──
handle /forecast* {
	# 로그인 1회로 끝낸다.
	#   예전: 앱 로그인 1회 + 브라우저 기본인증 팝업 1회 = 2회. iframe 안에서는 더 어색했다.
	#   지금: forward_auth 가 앱의 세션 쿠키를 대신 확인한다(2xx = 통과, 그 외 = 그대로 전달).
	#
	# ⚠ 대상이 /api/auth/status 가 아니라 /api/auth/verify 인 이유:
	#   status 는 비로그인에도 200 에 {"logged_in": false} 를 실어 보낸다(SPA 가 게이트를
	#   띄울지 판단하는 근거). forward_auth 는 2xx 를 곧 통과로 보므로 그것을 쓰면
	#   /forecast 가 누구에게나 열린다. verify 는 세션이 없으면 401 이다.
	forward_auth 127.0.0.1:8010 {
		uri /api/auth/verify
	}
	reverse_proxy 127.0.0.1:8501
}

# ── 그 외 = 앱(SPA) ──
# Phase 2: 루트가 소개 사이트가 아니라 로그인 게이트 → 작업공간이 된다.
# 팀원에게 알려줄 주소가 하나로 합쳐진다. 소개·문서는 /site/ 에 그대로 남는다.
handle {
	reverse_proxy 127.0.0.1:8010
}
