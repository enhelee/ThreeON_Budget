# 한 주소로 통합 — 경로별 라우팅. HTTPS는 Render/사내 프록시가 종단(auto_https off).
{
	admin off
	auto_https off
}

:{$PORT}

encode gzip
header {
	X-Content-Type-Options nosniff
	X-Frame-Options SAMEORIGIN
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

# ── 옛 주소 /app/ → 루트로 영구 이동 ──
# 팀원이 저장해 둔 북마크를 지킨다. 301 은 FastAPI 가 낸다(server.py 의 app_redirect).
#
# ⚠ handle_path 를 쓰면 안 된다 — «/app» 접두어를 떼고 보내므로 FastAPI 가 그 요청을
#   «/» 로 보고 SPA 를 그냥 돌려준다(301 이 나가지 않는다). 여기서는 접두어를 붙인 채
#   그대로 넘겨 FastAPI 가 /app/... 라우트를 만나게 한다.
#
# ⚠ Caddy 의 redir 로 처리하지 않는 이유:
#   `redir / permanent` 은 첫 인자 «/» 를 목적지가 아니라 **경로 매처**로 파싱한다.
#   요청 경로가 /app/ 이라 매처가 맞지 않아 리다이렉트가 발동하지 않고 빈 200 만 나갔다.
#   실측(2026-09-15 배포): GET /app/ -> 200, Content-Length 0, x-render-origin-server: Caddy.
#   절대 URL 형태로 쓰면 이 모호함은 없지만 스킴을 직접 만들어야 하는데, 앞단에서 TLS 가
#   끝나는 구조라 http 로 찍혀 혼합 콘텐츠가 된다(전망 앱에서 이미 겪은 함정이다).
#   FastAPI 로 넘기면 파이썬 테스트로 검증되는 코드가 301 을 낸다 — 그쪽이 안전하다.
handle /app* {
	reverse_proxy 127.0.0.1:8010
}
# ⚠ Vite 빌드 SPA 는 자산을 절대경로 /assets/... 로 부른다(base:"/").
#   파일명에 해시가 붙으므로 캐시를 길게 잡아도 안전하다(반대로 index.html 은
#   매번 재검증해야 한다 — server.py 의 no-cache 주석 참조).
handle /assets/* {
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy 127.0.0.1:8010
}

handle /api/* {
	reverse_proxy 127.0.0.1:8010
}
handle /healthz {
	reverse_proxy 127.0.0.1:8010
}

# ── forecast_app (Streamlit, baseUrlPath=forecast). 앱 세션을 엣지에서 확인 ──
handle /forecast* {
	# 로그인 1회로 끝낸다.
	#   예전: 앱 로그인 1회 + 브라우저 기본인증 팝업 1회 = 2회. iframe 안에서는 더 어색했다.
	#   지금: forward_auth 가 앱의 세션 쿠키를 대신 확인한다(2xx = 통과, 그 외 = 그대로 전달).
	#
	# ⚠ 대상이 /api/auth/status 가 아니라 /api/auth/verify 인 이유:
	#   status 는 비로그인에도 200 에 {"logged_in": false} 를 실어 보낸다(SPA 가 게이트를
	#   띄울지 판단하는 근거). forward_auth 는 2xx 를 곧 통과로 보므로 그것을 쓰면
	#   /forecast 가 누구에게나 열린다. verify 는 세션이 없으면 401 이다.
	forward_auth 127.0.0.1:8010 {
		uri /api/auth/verify

		# ⚠ 인증을 물어볼 때는 업그레이드 헤더를 떼고 묻는다.
		#   전망 앱은 WebSocket(/forecast/_stcore/stream)으로 동작한다. forward_auth 는
		#   원래 요청의 헤더를 그대로 달고 부속 요청을 보내는데, 거기에 Connection: Upgrade 와
		#   Upgrade: websocket 이 남아 있으면 uvicorn 이 그것을 «WebSocket 접속 시도»로 읽는다.
		#   /api/auth/verify 에는 WebSocket 라우트가 없으므로 403 으로 거절되고,
		#   forward_auth 는 2xx 가 아니면 통과시키지 않으니 진짜 WebSocket 도 함께 끊긴다.
		#
		#   실측(2026-09-15 배포):
		#     브라우저  wss://.../forecast/_stcore/stream -> handshake 403
		#     서버 로그 "WebSocket /api/auth/verify" 403 / connection rejected
		#               "GET /api/auth/verify" 204          <- 일반 요청은 정상이었다
		#   화면은 HTML 까지만 뜨고 Streamlit 이 초기화되지 못해 스켈레톤에서 멈췄다.
		#
		#   이 두 줄은 «인증 부속 요청»에만 적용된다 - 아래 reverse_proxy 로 가는 진짜
		#   WebSocket 은 헤더가 온전하므로 Streamlit 까지 그대로 연결된다.
		header_up -Connection
		header_up -Upgrade
	}
	reverse_proxy 127.0.0.1:8501
}

# ── 그 외 = 앱(SPA) ──
# 루트가 로그인 게이트 → 작업공간이다. 팀원에게 알려줄 주소는 이것 하나뿐이다.
# Phase 5: 소개·문서 사이트(/site)는 삭제했다 — SPA 가 소개를 흡수했고, 문서는
# 저장소의 docs/ 에서 본다. 웹으로 문서를 서빙할 이유가 사라졌다.
handle {
	reverse_proxy 127.0.0.1:8010
}
