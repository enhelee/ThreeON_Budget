# ThreeON 예산 프로젝트 — 비밀 설정 예시.  복사해서 `.env`로 저장하고 값을 채운다.
#   ⚠ .env 는 .gitignore 로 Git에 올라가지 않는다. 팀원에게는 별도 채널(사내 메신저 비밀 메모 등)로 전달.
#   로컬(budget_app 폴더)·Docker Compose(패키지 루트)·Render(대시보드 환경변수) 모두 같은 키를 쓴다.

# ── 접근 통제 ─────────────────────────────────────────────────────────────
# 팀 공용 비밀번호(사용자 결정: 계정 대신 1개). 12자 이상, 사전에 없는 문구 권장. 비우면 인증 OFF(사내망 전용).
APP_PASSWORD=
# 세션 쿠키 서명 키. 32자 이상 무작위.  생성: py -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 세션 유효시간(시간). 기본 12
SESSION_HOURS=12
# https 뒤(Render·사내 https 프록시)면 1, 사내 http 직결이면 0
COOKIE_SECURE=1
# /forecast(v2 Streamlit) 기본인증 사용자명. 비밀번호는 APP_PASSWORD와 동일
BASIC_USER=team

# ── 데이터베이스 ─────────────────────────────────────────────────────────
# 비우면 SQLite(DATA_DIR/budget.db). PostgreSQL(Supabase/사내)로 바꾸려면 연결 문자열을 넣는다.
#   Supabase: Project Settings → Database → Connection string → "Transaction" pooler(6543) 권장
#   postgresql://postgres.<프로젝트ref>:<DB비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require
#   Docker Compose(pg 프로필): postgresql://budget:<PG_PASSWORD>@postgres:5432/budget
DATABASE_URL=
# Docker Compose --profile pg 용
PG_DB=budget
PG_USER=budget
PG_PASSWORD=

# ── 경로(컨테이너는 Dockerfile 기본값, 로컬 실행 시만 필요) ────────────────
# DATA_DIR=./data
# CONFIG_DIR=./config
# OUT_DIR=./output
# SITE_DIR=../docs
# HOST_PORT=8080
